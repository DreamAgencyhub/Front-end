{
  "editor.formatOnSave": true,
  "files.autoSave": "onWindowChange",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.wordWrap": "on",
  "editor.mouseWheelZoom": true,
  "editor.formatOnPaste": true,

  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#6598c8",
    "activityBar.background": "#6598c8",
    "activityBar.foreground": "#15202b",
    "activityBar.inactiveForeground": "#15202b99",
    "activityBarBadge.background": "#945bc4",
    "activityBarBadge.foreground": "#e7e7e7",
    "commandCenter.border": "#15202b99",
    "sash.hoverBorder": "#6598c8",
    "statusBar.background": "#6598c8",
    "statusBar.foreground": "#15202b",
    "statusBarItem.hoverBackground": "#35927c",
    "statusBarItem.remoteBackground": "#6598c8",
    "statusBarItem.remoteForeground": "#15202b",
    "titleBar.activeBackground": "#6598c8",
    "titleBar.activeForeground": "#15202b",
    "titleBar.inactiveBackground": "#6598c899",
    "titleBar.inactiveForeground": "#15202b99"
  }
}
